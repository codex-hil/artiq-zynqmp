+/*****************************************************************************/
+/**
+ * This function returns log2 of the given value in argument
+ *
+ * @param	XVal is the value whose log2 value is returned
+ *
+ * @return	returns log2 of the given value
+ *
+ *****************************************************************************/
+static u32 XFsbl_GetLog2(u32 XVal)
+{
+	u32 RVal = 0U;
+
+	if (XVal == 0U) {
+		goto END;
+	}
+
+	while (XVal != 1U) {
+		RVal = RVal + 1U;
+		XVal = XVal >> 1U;
+	}
+
+END:
+	return RVal;
+}
