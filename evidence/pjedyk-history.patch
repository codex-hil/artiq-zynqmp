+	Xil_Out32(XFSBL_DDRC_BASE_ADDR + 0x26CU, Val);
+
+	Val =  ((DdrCfg[DDR_DQ_NIBBLE_MAP_12_15] & 0xFFU) << 24U)
+		+ ((DdrCfg[DDR_DQ_NIBBLE_MAP_8_11] & 0xFFU) << 16U)
